<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.indiaexams.portal-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/surajvadhya/Projects/indian-exams-dashboard/scripts/automation/run-portal-watch.sh</string>
    </array>

    <!-- Runs once daily at 09:00.

         If the Mac is ASLEEP at 09:00, launchd runs the job on wake.
         If the Mac is POWERED OFF at 09:00, that occurrence is LOST — launchd does not
         replay calendar events that elapsed while the machine was off. This plist used
         to claim otherwise, and on Sun 2026-09-20 the 09:00 run was silently skipped
         (Mac off 23:19 → 11:46). RunAtLoad below is the catch-up for exactly that case;
         run-portal-watch.sh then refuses a second run on a day that already succeeded,
         so startup never causes a duplicate. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/surajvadhya/Projects/indian-exams-dashboard</string>

    <key>StandardOutPath</key>
    <string>/Users/surajvadhya/Projects/indian-exams-dashboard/data-sourcing/portal-watch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/surajvadhya/Projects/indian-exams-dashboard/data-sourcing/portal-watch-stderr.log</string>

    <!-- The catch-up trigger. Fires on login/startup; the wrapper exits immediately and
         quietly if a run already succeeded today, so this only ever does work on a day
         whose 09:00 slot was missed because the Mac was off. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
